// name: RecordFieldAlias
// keywords: NewBackend
// status: correct
//
// Record fields are aliases of other variables (state.X = X with an inlined record function), the
// kept variable gets their nominal. g(state) uses the record of the replaced fields.

loadString("
package RecordFieldAlias
  record S Real p; Real X[2](each nominal = 0.1); end S;
  function f input Real p; input Real X[:]; output S s; algorithm s := S(p, X); annotation(Inline = true); end f;
  function g input S s; output Real y; algorithm y := s.p + s.X[1] * s.X[2]; annotation(Inline = false); end g;
  model C
    Real X[2];
    S state;
    Real p;
    Real y;
  equation
    state = f(p, X);
    X = {sin(time), cos(time)};
    p = time^2;
    y = g(state);
  end C;
  model Top C c[3]; C d; end Top;
end RecordFieldAlias;
"); getErrorString();

setCommandLineOptions("--newBackend -d=dumprepl"); getErrorString();
simulate(RecordFieldAlias.Top, simflags = "-lv=-LOG_STDOUT"); getErrorString();
val(c[2].y, 0.5);
val(d.y, 0.5);
regexBool(readFile("RecordFieldAlias.Top_init.xml"), "name = \"d.X\\[1\\]\"[^>]*>\n *<Real[^>]*nominal=\"0.1\"");

