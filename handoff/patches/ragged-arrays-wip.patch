+function hasElementDependentDimensions
+  "true if a dimension of a component in cls depends on the element of the array node"
+  input Class cls;
+  input InstNode node;
+  output Boolean res = false;
+protected
+  array<InstNode> comps;
+algorithm
+  () := match cls
+    case Class.INSTANCED_CLASS(elements = ClassTree.FLAT_TREE(components = comps))
+      algorithm
+        for c in comps loop
+          if InstNode.isComponent(c) then
+            res := List.any(Type.arrayDims(InstNode.getType(c)), function isElementDependentDimension(node = node))
+              or hasElementDependentDimensions(InstNode.getClass(c), node);
+            if res then
+              return;
+            end if;
+          end if;
+        end for;
+      then ();
+    else ();
+  end match;
+end hasElementDependentDimensions;
+
+function isElementDependentDimension
+  input Dimension dim;
+  input InstNode node;
+  output Boolean res;
+algorithm
+  res := match dim
+    case Dimension.EXP() then Expression.contains(dim.exp, function isSplitOfNode(node = node));
+    else false;
+  end match;
+end isElementDependentDimension;
+
+function isSplitOfNode
+  input Expression exp;
+  input InstNode node;
+  output Boolean res;
+algorithm
+  res := match exp
+    case Expression.SUBSCRIPTED_EXP(split = true)
+      then List.any(exp.subscripts, function isSplitIndexOfNode(node = node));
+    else false;
+  end match;
+end isSplitOfNode;
+
+function isSplitIndexOfNode
+  input Subscript sub;
+  input InstNode node;
+  output Boolean res;
+algorithm
+  res := match sub
+    case Subscript.SPLIT_INDEX() then InstNode.refEqual(InstNode.borrow(sub.node), node);
+    else false;
+  end match;
+end isSplitIndexOfNode;
